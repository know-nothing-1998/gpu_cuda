{
    "terminal.integrated.profiles.windows": {
        "MSVC x64": {
            "path": "${env:ComSpec}",
            "args": [
                "/d",
                "/k",
                ".vscode\\msvc-terminal.cmd"
            ],
            "env": {
                "PATH": "C:\\Program Files (x86)\\Microsoft Visual Studio\\Installer;${env:PATH}"
            },
            "overrideName": true
        }
    },
    "terminal.integrated.defaultProfile.windows": "MSVC x64",
    "terminal.integrated.cwd": "${workspaceFolder}"
}
